# t3k_pub_ key from TONE3000 Settings > API Keys. The redirect URI must be registered on it.
VITE_PUBLISHABLE_KEY=t3k_pub_your_key_here
VITE_REDIRECT_URI=http://localhost:3001

# Optional: override the TONE3000 API domain (default https://www.tone3000.com)
# VITE_T3K_API_DOMAIN=http://localhost:3000
